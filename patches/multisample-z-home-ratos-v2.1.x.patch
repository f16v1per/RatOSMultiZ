+    def _retract_and_home(self, endstops, forcepos, movepos,
+                          retract_dist, retract_speed, home_speed):
+        startpos = self._fill_coord(forcepos)
+        homepos = self._fill_coord(movepos)
+        axes_d = [hp - sp for hp, sp in zip(homepos, startpos)]
+        move_d = math.sqrt(sum([d*d for d in axes_d[:3]]))
+        retract_r = min(1., retract_dist / move_d)
+        retractpos = [hp - ad * retract_r for hp, ad in zip(homepos, axes_d)]
+        self.toolhead.move(retractpos, retract_speed)
+        startpos = [rp - ad * retract_r for rp, ad in zip(retractpos, axes_d)]
+        self.toolhead.set_position(startpos)
+        hmove = HomingMove(self.printer, endstops)
+        hmove.homing_move(homepos, home_speed)
+        no_movement = hmove.check_no_movement()
+        if no_movement is not None:
+            raise self.printer.command_error(
+                "Endstop %s still triggered after retract" % (no_movement,))
+        return hmove
+    def _get_home_sampling_params(self, endstops, hi):
+        for mcu_endstop, name in endstops:
+            if hasattr(mcu_endstop, "get_home_sampling_params"):
+                params = mcu_endstop.get_home_sampling_params(hi)
+                if params['samples'] > 1:
+                    return params
+        return None
+    def _get_homing_trigger_positions(self, hmove):
+        return {sp.stepper_name: (sp.start_cmd_pos
+                                  + (sp.trig_pos - sp.start_pos)
+                                  * sp.stepper.get_step_dist())
+                for sp in hmove.stepper_positions}
+    def _get_homing_sample_value(self, sample):
+        return sum(sample.values()) / len(sample)
+    def _report_home_samples(self, samples, sample_count):
+        gcode = self.printer.lookup_object('gcode')
+        sample_values = [self._get_homing_sample_value(s) for s in samples]
+        range_value = max(sample_values) - min(sample_values)
+        sample_text = ", ".join(["%.6f" % (value,)
+                                 for value in sample_values])
+        delta_text = ""
+        if len(sample_values) > 1:
+            delta_text = " deltas [%s]" % (
+                ", ".join(["%+.6f" % (sample_values[i] - sample_values[i-1],)
+                           for i in range(1, len(sample_values))]),)
+        gcode.respond_info(
+            "G28 Z samples %d/%d: [%s]%s range %.6f" % (
+                len(samples), sample_count, sample_text,
+                delta_text, range_value))
+    def _average_homing_samples(self, samples):
+        inv_count = 1. / float(len(samples))
+        return {name: sum([s[name] for s in samples]) * inv_count
+                for name in samples[0]}
+    def _calc_homing_sample_result(self, samples, method):
+        if method != 'median':
+            return self._average_homing_samples(samples)
+        samples = sorted(samples, key=self._get_homing_sample_value)
+        middle = len(samples) // 2
+        if len(samples) & 1:
+            return samples[middle]
+        return self._average_homing_samples(samples[middle-1:middle+1])
+    def _sample_home_rails(self, endstops, forcepos, movepos, params):
+        samples = []
+        retries = 0
+        sample_count = params['samples']
+        while len(samples) < sample_count:
+            hmove = self._retract_and_home(
+                endstops, forcepos, movepos, params['retract_dist'],
+                params['lift_speed'], params['speed'])
+            samples.append(self._get_homing_trigger_positions(hmove))
+            self._report_home_samples(samples, sample_count)
+            sample_values = [self._get_homing_sample_value(s)
+                             for s in samples]
+            if max(sample_values) - min(sample_values) > params['tolerance']:
+                if retries >= params['retries']:
+                    raise self.printer.command_error(
+                        "Z home samples exceed z_home_samples_tolerance")
+                logging.info("Z home samples exceed tolerance. Retrying...")
+                retries += 1
+                samples = []
+        result = self._calc_homing_sample_result(samples, params['result'])
+        gcode = self.printer.lookup_object('gcode')
+        gcode.respond_info(
+            "G28 Z final %s from samples: %.6f" % (
+                params['result'], self._get_homing_sample_value(result)))
+        last_sample = samples[-1]
+        adjustments = {}
+        for stepper_name, trigger_pos in last_sample.items():
+            adjustments[stepper_name] = trigger_pos - result[stepper_name]
+        return hmove, adjustments
